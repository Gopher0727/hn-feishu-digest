PUSH_MODE=company
TASK_ROLE=consumer
DATA_REPO=YOUR_USERNAME/hn-digest-data
DATA_TOKEN=replace-with-contents-read-token
DATA_DIR=./data
STATE_DIR=./state-company
LLM_PROVIDER=llamacpp
LLM_BASE_URL=http://127.0.0.1:8080/v1
# Match llama-server --alias or the id returned by /v1/models.
LLM_MODEL=hn-local
LLM_API_KEY=
LLM_JSON_MODE=true
LLM_MAX_TOKENS=2048
LLM_BATCH_SIZE=2
LLM_TIMEOUT_SECONDS=600
FEISHU_WEBHOOK=replace-me
FEISHU_SIGN_SECRET=replace-me
